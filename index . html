<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>X 3D Printing</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }
    :root {
      --bg: #08090b;
      --surface: #111318;
      --surface-2: #181b21;
      --border: #272b33;
      --text: #f5f5f5;
      --muted: #9ca3af;
      --accent: #7c3aed;
      --accent-2: #a855f7;
      --white: #ffffff;
      --danger: #ef4444;
      --success: #22c55e;
    }
    body {
      font-family: Arial, Helvetica, sans-serif;
      background: var(--bg);
      color: var(--text);
      line-height: 1.6;
    }
    button,
    input,
    select,
    textarea {
      font: inherit;
    }
    button {
      cursor: pointer;
    }
    a {
      color: inherit;
      text-decoration: none;
    }
    img {
      max-width: 100%;
      display: block;
    }
    /* ================= HEADER ================= */
    header {
      position: sticky;
      top: 0;
      z-index: 1000;
      background: rgba(8, 9, 11, 0.92);
      backdrop-filter: blur(16px);
      border-bottom: 1px solid var(--border);
    }
    .nav {
      max-width: 1200px;
      margin: auto;
      height: 72px;
      padding: 0 24px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .logo {
      font-size: 22px;
      font-weight: 900;
      letter-spacing: -1px;
    }
    .logo span {
      color: var(--accent-2);
    }
    .nav-links {
      display: flex;
      gap: 30px;
      align-items: center;
    }
    .nav-links a {
      color: #d1d5db;
      font-size: 14px;
      transition: 0.2s;
    }
    .nav-links a:hover {
      color: white;
    }
    .nav-actions {
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .icon-btn {
      width: 42px;
      height: 42px;
      border: 1px solid var(--border);
      background: var(--surface);
      color: white;
      border-radius: 10px;
      position: relative;
    }
    .cart-count {
      position: absolute;
      top: -5px;
      right: -5px;
      width: 19px;
      height: 19px;
      border-radius: 50%;
      background: var(--accent);
      font-size: 11px;
      display: grid;
      place-items: center;
    }
    .menu-btn {
      display: none;
    }
    /* ================= HERO ================= */
    .hero {
      max-width: 1200px;
      margin: auto;
      min-height: 620px;
      padding: 100px 24px;
      display: grid;
      grid-template-columns: 1.1fr 0.9fr;
      gap: 60px;
      align-items: center;
    }
    .eyebrow {
      color: var(--accent-2);
      text-transform: uppercase;
      letter-spacing: 3px;
      font-size: 12px;
      font-weight: bold;
      margin-bottom: 18px;
    }
    .hero h1 {
      font-size: clamp(48px, 7vw, 82px);
      line-height: 0.98;
      letter-spacing: -4px;
      margin-bottom: 25px;
    }
    .hero h1 span {
      color: var(--accent-2);
    }
    .hero p {
      color: var(--muted);
      max-width: 550px;
      font-size: 17px;
      margin-bottom: 32px;
    }
    .hero-actions {
      display: flex;
      gap: 12px;
      flex-wrap: wrap;
    }
    .btn {
      border: none;
      border-radius: 10px;
      padding: 13px 22px;
      font-weight: bold;
      transition: 0.2s;
    }
    .btn-primary {
      background: var(--accent);
      color: white;
    }
    .btn-primary:hover {
      background: var(--accent-2);
      transform: translateY(-1px);
    }
    .btn-secondary {
      background: transparent;
      color: white;
      border: 1px solid var(--border);
    }
    .btn-secondary:hover {
      background: var(--surface);
    }
    .hero-visual {
      min-height: 420px;
      border: 1px solid var(--border);
      border-radius: 24px;
      background:
        radial-gradient(circle at 50% 30%, rgba(168,85,247,.3), transparent 35%),
        linear-gradient(145deg, #171923, #090a0d);
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      overflow: hidden;
    }
    .printer {
      width: 250px;
      height: 280px;
      border: 8px solid #343943;
      border-radius: 12px;
      position: relative;
      box-shadow: 0 30px 80px rgba(124,58,237,.2);
    }
    .printer::before {
      content: "";
      position: absolute;
      width: 120px;
      height: 12px;
      background: #777;
      top: 55px;
      left: 55px;
    }
    .printer::after {
      content: "";
      position: absolute;
      width: 70px;
      height: 70px;
      background: var(--accent);
      bottom: 45px;
      left: 82px;
      clip-path: polygon(50% 0%, 100% 100%, 0% 100%);
      filter: drop-shadow(0 0 20px rgba(168,85,247,.6));
    }
    /* ================= SECTION ================= */
    section {
      max-width: 1200px;
      margin: auto;
      padding: 80px 24px;
    }
    .section-head {
      display: flex;
      justify-content: space-between;
      align-items: end;
      gap: 20px;
      margin-bottom: 35px;
    }
    .section-head h2 {
      font-size: 36px;
      letter-spacing: -1.5px;
    }
    .section-head p {
      color: var(--muted);
      max-width: 500px;
    }
    /* ================= CATEGORIES ================= */
    .categories {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 15px;
    }
    .category {
      min-height: 160px;
      padding: 25px;
      border: 1px solid var(--border);
      background: var(--surface);
      border-radius: 16px;
      display: flex;
      flex-direction: column;
      justify-content: end;
      transition: 0.2s;
    }
    .category:hover {
      transform: translateY(-4px);
      border-color: var(--accent);
    }
    .category-icon {
      font-size: 32px;
      margin-bottom: auto;
    }
    .category h3 {
      font-size: 17px;
    }
    .category p {
      color: var(--muted);
      font-size: 13px;
    }
    /* ================= PRODUCTS ================= */
    .products {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 18px;
    }
    .product {
      border: 1px solid var(--border);
      background: var(--surface);
      border-radius: 16px;
      overflow: hidden;
      transition: 0.2s;
    }
    .product:hover {
      transform: translateY(-5px);
      border-color: #4b5563;
    }
    .product-image {
      height: 240px;
      background: #17191f;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 70px;
      position: relative;
    }
    .badge {
      position: absolute;
      top: 12px;
      left: 12px;
      padding: 5px 9px;
      border-radius: 6px;
      background: var(--accent);
      font-size: 11px;
      font-weight: bold;
    }
    .product-info {
      padding: 17px;
    }
    .product-info h3 {
      font-size: 16px;
      margin-bottom: 5px;
    }
    .product-info p {
      color: var(--muted);
      font-size: 13px;
      margin-bottom: 12px;
    }
    .price-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .price {
      font-size: 18px;
      font-weight: 800;
    }
    .add-btn {
      border: 1px solid var(--border);
      background: var(--surface-2);
      color: white;
      padding: 8px 11px;
      border-radius: 8px;
      font-size: 12px;
    }
    .add-btn:hover {
      background: var(--accent);
    }
    /* ================= CUSTOM ================= */
    .custom {
      background:
        linear-gradient(145deg, rgba(124,58,237,.18), transparent 55%),
        var(--surface);
      border: 1px solid var(--border);
      border-radius: 25px;
      padding: 50px;
      display: grid;
      grid-template-columns: 0.9fr 1.1fr;
      gap: 50px;
    }
    .custom h2 {
      font-size: 40px;
      line-height: 1.1;
      margin-bottom: 18px;
    }
    .custom p {
      color: var(--muted);
    }
    .custom-form {
      display: grid;
      gap: 15px;
    }
    .field {
      display: grid;
      gap: 7px;
    }
    .field label {
      font-size: 13px;
      color: #d1d5db;
    }
    .field input,
    .field select,
    .field textarea {
      width: 100%;
      background: #0c0d10;
      border: 1px solid var(--border);
      border-radius: 9px;
      padding: 12px;
      color: white;
      outline: none;
    }
    .field input:focus,
    .field select:focus,
    .field textarea:focus {
      border-color: var(--accent);
    }
    .field textarea {
      min-height: 100px;
      resize: vertical;
    }
    /* ================= CART ================= */
    .overlay {
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,.65);
      z-index: 1999;
      display: none;
    }
    .overlay.active {
      display: block;
    }
    .cart-panel {
      position: fixed;
      top: 0;
      right: -450px;
      width: 430px;
      max-width: 100%;
      height: 100vh;
      background: #101116;
      border-left: 1px solid var(--border);
      z-index: 2000;
      transition: .3s;
      display: flex;
      flex-direction: column;
    }
    .cart-panel.active {
      right: 0;
    }
    .cart-head {
      padding: 22px;
      border-bottom: 1px solid var(--border);
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .cart-items {
      flex: 1;
      overflow-y: auto;
      padding: 20px;
    }
    .cart-item {
      display: flex;
      gap: 12px;
      border-bottom: 1px solid var(--border);
      padding: 15px 0;
    }
    .cart-item-image {
      width: 70px;
      height: 70px;
      border-radius: 9px;
      background: #191b21;
      display: grid;
      place-items: center;
      font-size: 28px;
    }
    .cart-item-info {
      flex: 1;
    }
    .cart-item-info h4 {
      font-size: 14px;
    }
    .cart-item-info p {
      color: var(--muted);
      font-size: 13px;
    }
    .remove {
      color: var(--danger);
      background: none;
      border: none;
      font-size: 12px;
    }
    .cart-footer {
      border-top: 1px solid var(--border);
      padding: 20px;
    }
    .total-row {
      display: flex;
      justify-content: space-between;
      margin-bottom: 15px;
      font-weight: bold;
    }
    /* ================= CHECKOUT ================= */
    .modal {
      position: fixed;
      inset: 0;
      z-index: 3000;
      display: none;
      align-items: center;
      justify-content: center;
      padding: 20px;
      background: rgba(0,0,0,.7);
    }
    .modal.active {
      display: flex;
    }
    .modal-box {
      width: 600px;
      max-width: 100%;
      max-height: 90vh;
      overflow-y: auto;
      background: #111318;
      border: 1px solid var(--border);
      border-radius: 18px;
      padding: 28px;
    }
    .modal-head {
      display: flex;
      justify-content: space-between;
      margin-bottom: 25px;
    }
    .checkout-form {
      display: grid;
      gap: 15px;
    }
    /* ================= FOOTER ================= */
    footer {
      border-top: 1px solid var(--border);
      margin-top: 40px;
    }
    .footer-inner {
      max-width: 1200px;
      margin: auto;
      padding: 50px 24px;
      display: grid;
      grid-template-columns: 2fr 1fr 1fr;
      gap: 50px;
    }
    footer p,
    footer a {
      color: var(--muted);
      font-size: 14px;
    }
    footer h4 {
      margin-bottom: 15px;
    }
    .footer-links {
      display: grid;
      gap: 8px;
    }
    .copyright {
      border-top: 1px solid var(--border);
      text-align: center;
      padding: 20px;
      color: var(--muted);
      font-size: 13px;
    }
    /* ================= MOBILE ================= */
    @media (max-width: 900px) {
      .hero {
        grid-template-columns: 1fr;
        padding-top: 70px;
      }
      .products {
        grid-template-columns: repeat(2, 1fr);
      }
      .categories {
        grid-template-columns: repeat(2, 1fr);
      }
      .custom {
        grid-template-columns: 1fr;
        padding: 30px;
      }
      .nav-links {
        display: none;
      }
      .menu-btn {
        display: block;
      }
      .footer-inner {
        grid-template-columns: 1fr;
      }
    }
    @media (max-width: 550px) {
      .hero h1 {
        font-size: 50px;
      }
      .products {
        grid-template-columns: 1fr;
      }
      .categories {
        grid-template-columns: 1fr 1fr;
      }
      .hero-visual {
        min-height: 320px;
      }
      .custom h2 {
        font-size: 30px;
      }
    }
  </style>
</head>
<body>
  <!-- ================= HEADER ================= -->
  <header>
    <nav class="nav">
      <a href="#" class="logo">
        X <span>3D</span> PRINTING
      </a>
      <div class="nav-links">
        <a href="#home">Home</a>
        <a href="#shop">Shop</a>
        <a href="#custom">Custom Print</a>
        <a href="#categories">Categories</a>
      </div>
      <div class="nav-actions">
        <button class="icon-btn" onclick="openCart()">
          🛒
          <span class="cart-count" id="cartCount">0</span>
        </button>
        <button class="icon-btn menu-btn">
          ☰
        </button>
      </div>
    </nav>
  </header>
  <!-- ================= HERO ================= -->
  <main id="home">
    <div class="hero">
      <div>
        <div class="eyebrow">
          3D Printing Studio
        </div>
        <h1>
          PRINT YOUR
          <span>IDEAS.</span>
        </h1>
        <p>
          Discover unique 3D printed products or bring your own
          design to life with our custom 3D printing service.
        </p>
        <div class="hero-actions">
          <a href="#shop" class="btn btn-primary">
            Explore Products
          </a>
          <a href="#custom" class="btn btn-secondary">
            Custom Print
          </a>
        </div>
      </div>
      <div class="hero-visual">
        <div class="printer"></div>
      </div>
    </div>
    <!-- ================= CATEGORIES ================= -->
    <section id="categories">
      <div class="section-head">
        <div>
          <div class="eyebrow">Explore</div>
          <h2>Shop by Category</h2>
        </div>
        <p>
          Explore our collection of creative and functional
          3D printed products.
        </p>
      </div>
      <div class="categories">
        <div class="category">
          <div class="category-icon">🎨</div>
          <h3>Figures</h3>
          <p>Unique 3D printed figures</p>
        </div>
        <div class="category">
          <div class="category-icon">🏠</div>
          <h3>Home Decor</h3>
          <p>Modern printed decorations</p>
        </div>
        <div class="category">
          <div class="category-icon">🔑</div>
          <h3>Keychains</h3>
          <p>Personalized accessories</p>
        </div>
        <div class="category">
          <div class="category-icon">⚙️</div>
          <h3>Accessories</h3>
          <p>Useful everyday products</p>
        </div>
      </div>
    </section>
    <!-- ================= PRODUCTS ================= -->
    <section id="shop">
      <div class="section-head">
        <div>
          <div class="eyebrow">Our Collection</div>
          <h2>Featured Products</h2>
        </div>
        <p>
          High-quality 3D printed products made with attention
          to detail.
        </p>
      </div>
      <div class="products" id="products"></div>
    </section>
    <!-- ================= CUSTOM PRINT ================= -->
    <section id="custom">
      <div class="custom">
        <div>
          <div class="eyebrow">
            Custom Manufacturing
          </div>
          <h2>
            Have a design?
            <br>
            We'll print it.
          </h2>
          <p>
            Upload your 3D model and tell us what you need.
            We'll review your design and send you a quote.
          </p>
          <br>
          <p>
            Supported formats:
            <strong>STL, OBJ</strong>
          </p>
        </div>
        <form class="custom-form" id="customForm">
          <div class="field">
            <label>3D Model</label>
            <input
              type="file"
              id="modelFile"
              accept=".stl,.obj"
              required
            >
          </div>
          <div class="field">
            <label>Material</label>
            <select id="material">
              <option>PLA</option>
              <option>PETG</option>
              <option>TPU</option>
              <option>Resin</option>
            </select>
          </div>
          <div class="field">
            <label>Color</label>
            <select id="color">
              <option>Black</option>
              <option>White</option>
              <option>Red</option>
              <option>Blue</option>
              <option>Green</option>
              <option>Custom Color</option>
            </select>
          </div>
          <div class="field">
            <label>Quantity</label>
            <input
              type="number"
              id="customQuantity"
              min="1"
              value="1"
            >
          </div>
          <div class="field">
            <label>Notes</label>
            <textarea
              id="customNotes"
              placeholder="Tell us anything about your print..."
            ></textarea>
          </div>
          <button class="btn btn-primary" type="submit">
            Request Quote
          </button>
        </form>
      </div>
    </section>
  </main>
  <!-- ================= CART OVERLAY ================= -->
  <div
    class="overlay"
    id="overlay"
    onclick="closeCart()"
  ></div>
  <!-- ================= CART ================= -->
  <aside class="cart-panel" id="cartPanel">
    <div class="cart-head">
      <h2>Your Cart</h2>
      <button
        class="icon-btn"
        onclick="closeCart()"
      >
        ×
      </button>
    </div>
    <div class="cart-items" id="cartItems"></div>
    <div class="cart-footer">
      <div class="total-row">
        <span>Total</span>
        <span id="cartTotal">0 EGP</span>
      </div>
      <button
        class="btn btn-primary"
        style="width:100%"
        onclick="openCheckout()"
      >
        Proceed to Checkout
      </button>
    </div>
  </aside>
  <!-- ================= CHECKOUT MODAL ================= -->
  <div class="modal" id="checkoutModal">
    <div class="modal-box">
      <div class="modal-head">
        <div>
          <div class="eyebrow">Checkout</div>
          <h2>Complete Your Order</h2>
        </div>
        <button
          class="icon-btn"
          onclick="closeCheckout()"
        >
          ×
        </button>
      </div>
      <form
        class="checkout-form"
        id="checkoutForm"
      >
        <div class="field">
          <label>Full Name</label>
          <input
            type="text"
            id="customerName"
            required
            placeholder="Your name"
          >
        </div>
        <div class="field">
          <label>Phone Number</label>
          <input
            type="tel"
            id="customerPhone"
            required
            placeholder="01xxxxxxxxx"
          >
        </div>
        <div class="field">
          <label>Governorate</label>
          <select id="governorate">
            <option>Cairo</option>
            <option>Giza</option>
            <option>Alexandria</option>
            <option>Qalyubia</option>
            <option>Sharqia</option>
            <option>Dakahlia</option>
            <option>Other</option>
          </select>
        </div>
        <div class="field">
          <label>Address</label>
          <textarea
            id="address"
            required
            placeholder="Full delivery address"
          ></textarea>
        </div>
        <div class="field">
          <label>Payment Method</label>
          <select id="paymentMethod">
            <option>Cash on Delivery</option>
          </select>
        </div>
        <button
          class="btn btn-primary"
          type="submit"
        >
          Confirm Order
        </button>
      </form>
    </div>
  </div>
  <!-- ================= FOOTER ================= -->
  <footer>
    <div class="footer-inner">
      <div>
        <div class="logo">
          X <span>3D</span> PRINTING
        </div>
        <br>
        <p>
          Turning digital ideas into real objects.
          Discover unique 3D printed products or create
          something completely custom.
        </p>
      </div>
      <div>
        <h4>Shop</h4>
        <div class="footer-links">
          <a href="#shop">All Products</a>
          <a href="#categories">Categories</a>
          <a href="#custom">Custom Printing</a>
        </div>
      </div>
      <div>
        <h4>Contact</h4>
        <div class="footer-links">
          <a href="#">Instagram</a>
          <a href="#">Facebook</a>
          <a href="#">WhatsApp</a>
        </div>
      </div>
    </div>
    <div class="copyright">
      © 2026 X 3D Printing. All rights reserved.
    </div>
  </footer>
